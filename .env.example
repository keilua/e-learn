# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais committer de fichier .env contenant des valeurs réelles.

# --- Client (exposées au navigateur, préfixe VITE_) ---
# URL du projet Supabase (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=
# Clé publique "anon" Supabase (protégée par les politiques RLS)
VITE_SUPABASE_ANON_KEY=

# --- Serveur / outillage uniquement (JAMAIS préfixées VITE_) ---
# Clé de service Supabase : contourne la RLS, ne doit jamais atteindre le navigateur
SUPABASE_SERVICE_ROLE_KEY=
# Chaîne de connexion Postgres (pooler, mode transaction, port 6543)
SUPABASE_DB_URL=
# Jeton d'accès CLI Supabase (CI : migrations, supabase db dump)
SUPABASE_ACCESS_TOKEN=
